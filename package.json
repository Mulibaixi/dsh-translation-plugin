{
  "name": "dsh-translation-plugin",
  "version": "0.25.1",
  "private": true,
  "license": "MIT",
  "description": "A DeepSeek Harness translation plugin framework (early development).",
  "type": "module",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "dsh-composer-extension": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "dsh-composer-extension": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:native": "npm run build && node --expose-internals --test tests/*.integration.mjs scripts/*.integration.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:commit": "node scripts/check-commit-message.mjs",
    "check:policy": "node scripts/check-staged-files.mjs"
  },
  "devDependencies": {
    "dsh-composer-extension": "link:../dsh-composer-extension",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
