{
  "name": "dsh-translation-plugin",
  "version": "0.26.7",
  "private": true,
  "license": "MIT",
  "description": "Translation and refinement workspace for DeepSeek Harness, with topic memory, revision history, and main-model collaboration.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mulibaixi/dsh-translation-plugin.git"
  },
  "homepage": "https://github.com/Mulibaixi/dsh-translation-plugin#readme",
  "bugs": {
    "url": "https://github.com/Mulibaixi/dsh-translation-plugin/issues"
  },
  "type": "module",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "docs/user-guide.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "dsh-composer-extension": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "dsh-composer-extension": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:native": "npm run build && node --expose-internals --test --test-concurrency=4 tests/*.integration.mjs scripts/*.integration.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:commit": "node scripts/check-commit-message.mjs",
    "check:policy": "node scripts/check-staged-files.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "dsh-composer-extension": "link:../dsh-composer-extension",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0"
  }
}
